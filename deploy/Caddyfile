# DUCK DAQ - Caddy Reverse Proxy Configuration
#
# This Caddyfile handles:
# - HTTP only (no HTTPS)
# - Static file serving for Vue.js frontend (base path: /daq/)
# - Reverse proxy to Go backend API (ConnectRPC) at /duck_api/
# - WebSocket proxy for Centrifugo real-time updates at /connection/websocket

{
    auto_https off
}

# ============================================
# MAIN SITE CONFIGURATION (HTTP only)
# ============================================
:80 {
    log {
        output file /var/log/caddy/access.log
        format json
    }

    encode gzip zstd

    root * /var/www/html

    # ---- API ROUTES ----

    # ConnectRPC Backend API
    # Frontend uses VITE_API_SERVER=/daq/duck_api, so requests arrive as:
    #   /daq/duck_api/apiService.DuckAPI/GetToken
    # Backend mounts at /daq/apiService.DuckAPI/ (server.go:103), so it expects:
    #   /daq/apiService.DuckAPI/GetToken
    # Regex strips /duck_api from the middle, preserving the /daq prefix.
    @duck_api path_regexp duck_api ^/daq/duck_api(.*)$
    handle @duck_api {
        rewrite * /daq{re.duck_api.1}
        reverse_proxy {$API_HOST:api}:1323 {
            transport http {
                read_timeout 300s
                write_timeout 300s
            }
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # ---- WEBSOCKET ROUTES ----

    # Centrifugo WebSocket endpoint
    # When VITE_WS_SERVER is unset, the frontend auto-detects ws://host/daq/connection/websocket
    # Centrifugo expects /connection/websocket, so strip the /daq prefix before proxying.
    handle /daq/connection/websocket {
        uri strip_prefix /daq
        reverse_proxy {$CENTRIFUGO_HOST:centrifugo}:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # ---- STATIC FILES (Vue.js Frontend) ----

    # Cache immutable static assets
    @staticFiles {
        path_regexp \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$
    }
    handle @staticFiles {
        uri strip_prefix /daq
        file_server {
            precompressed br gzip
        }
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Vue.js SPA - strip /daq prefix and serve with index.html fallback
    handle /daq/* {
        uri strip_prefix /daq
        try_files {path} /index.html
        file_server
    }

    # Redirect root to /daq/
    handle / {
        redir /daq/ permanent
    }
}

# ============================================
# HEALTH CHECK ENDPOINT (internal)
# ============================================
:9090 {
    handle /health {
        respond "Caddy OK" 200
    }
}
